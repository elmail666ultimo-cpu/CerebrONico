# ════════════════════════════════════════════════════════════════════════
# CerebroNico IDE — plantilla de credenciales (v2.5)
# Copia este fichero a `.env` y rellena SOLO lo que uses. Nada de esto es
# obligatorio para arrancar: el IDE, el cerebro de planes, el reflejo y las
# 40 entidades funcionan sin ninguna clave. Las claves activan MEJORAS.
# ════════════════════════════════════════════════════════════════════════

# ── Motor local (Ollama) — sin clave; solo la URL si no es la por defecto ──
OLLAMA_URL=http://127.0.0.1:11434
# Modelo que usa el CONSEJO cuando el director tiene nombre propio:
# CEREBRONICO_DIRECTOR=smollm2:135m-instruct-q3_K_S

# ── Imágenes: capa gratuita SIN clave (Pollinations anónimo, ~12-46 s) ─────
# Con clave: modelos reales (flux), prioridad en cola y más rápido:
# POLLINATIONS_API_KEY=sk_...

# ── Nube (cada una es opcional; sin clave, ese proveedor no aparece) ───────
# GEMINI_API_KEY=...        # también da respaldo de imagen (gemini-3.1-flash-image)
# OPENAI_API_KEY=...
# OPENROUTER_API_KEY=...
# ANTHROPIC_API_KEY=...

# ── Servidor ────────────────────────────────────────────────────────────────
# PORT=3000
# HOST=127.0.0.1            # 0.0.0.0 SOLO con ACCESS_TOKEN puesto
# ACCESS_TOKEN=...

# ── Instalación de modelos en `npm install` ─────────────────────────────────
# 1 = no bajar ningún modelo (se declara el salto, no es un fallo):
# CEREBRONICO_SIN_MODELOS=1
